% ============================================================
% Tasks
% ============================================================

\newenvironment{task}[1][]
{
    \begin{tcolorbox}[
        breakable,
        colback=white,
        colframe=white,
        boxrule=0pt,
        arc=0pt,
        boxsep=0pt,
        left=0mm,
        right=0mm,
        top=2mm,
        bottom=2mm,
        before skip=8pt,
        after skip=8pt
    ]

    \if\relax\detokenize{#1}\relax
        \textbf{Task}
    \else
        \textbf{Task: #1}
    \fi

    \vspace{2mm}
}
{
    \end{tcolorbox}
}

% ============================================================
% Questions
% ============================================================

\newcounter{question}

\newenvironment{question}[1][]
{
    \refstepcounter{question}

    \par
    \vspace{8pt}

    \noindent
    {\bfseries Question~\thequestion}

    \if\relax\detokenize{#1}\relax
    \else
        \hfill
        {\normalfont\itshape #1}
    \fi

    \par
    \vspace{4pt}
}
{
    \par
    \vspace{6pt}
}

