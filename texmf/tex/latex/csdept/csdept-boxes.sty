\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{csdept-boxes}[2026/09/30 v0.6 Department teaching environments]

\RequirePackage{xcolor}
\RequirePackage{tcolorbox}
\tcbuselibrary{breakable}

% ============================================================
% Colors
% ============================================================

\definecolor{csdeptaccent}{HTML}{17365D}

\definecolor{csdeptimportantbg}{HTML}{FDECEC}
\definecolor{csdeptnotebg}{HTML}{EAF6EA}

% ============================================================
% Exercises
% ============================================================

\definecolor{csdeptexercisebg}{HTML}{F2F2F2}

\newcounter{exercise}
\renewcommand{\theexercise}{\arabic{exercise}}

\newenvironment{exercise}[1][]
{
    \refstepcounter{exercise}

    \par
    \vspace{10pt}

    % Exercise title
    \begin{tcolorbox}[
        colback=csdeptexercisebg,
        colframe=csdeptexercisebg,
        boxrule=0pt,
        arc=4pt,
        boxsep=0pt,
        left=5mm,
        right=5mm,
        top=3mm,
        bottom=3mm,
        before skip=0pt,
        after skip=8pt
    ]

    {\bfseries
        Exercise~\theexercise
        \if\relax\detokenize{#1}\relax
        \else
            \ -- #1
        \fi
    }

    \end{tcolorbox}

    % Exercise body
    \begin{list}{}{
        \setlength{\leftmargin}{5mm}
        \setlength{\rightmargin}{5mm}
        \setlength{\topsep}{0pt}
        \setlength{\partopsep}{0pt}
        \setlength{\parsep}{0pt}
    }
    \item[]
}
{
    \end{list}

    \par
    \vspace{6pt}
}
% ============================================================
% Important
% ============================================================

\newenvironment{important}
{
    \begin{tcolorbox}[
        breakable,
        colback=csdeptimportantbg,
        colframe=csdeptimportantbg,
        boxrule=0pt,
        arc=4pt,
        boxsep=0pt,
        left=5mm,
        right=5mm,
        top=5mm,
        bottom=5mm,
        before skip=8pt,
        after skip=8pt
    ]

    \textbf{Important}

    \vspace{2mm}
}
{
    \end{tcolorbox}
}

